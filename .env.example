REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Upstash Redis (required when deploying to Vercel or any other serverless
# platform - see README "Storage" section). Leave unset for local dev, which
# falls back to flat-file JSON in ./data automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
